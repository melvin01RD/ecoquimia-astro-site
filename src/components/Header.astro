---
const links = [
  { href: "/", label: "Inicio" },
  { href: "/nosotros", label: "Nosotros" },
  { href: "/servicios", label: "Servicios" },
  { href: "/contacto", label: "Contacto" },
];

const { pathname } = Astro.url;
const isActive = (href: string) => pathname === href || (href !== "/" && pathname.startsWith(`${href}/`));
---

<header class="site-header sticky top-0 z-50" data-js="header">
  <div class="container-max flex min-h-20 w-full items-center justify-between gap-3 py-3 md:gap-4">
    <a href="/" class="inline-flex max-w-[9.5rem] shrink items-center no-underline sm:max-w-[10.5rem] md:max-w-none" aria-label="Inicio">
      <img
        src="/logo/logo.png"
        alt="Ecoquimia"
        width="210"
        height="120"
        class="block h-10 max-w-full w-auto select-none sm:h-11 md:h-12"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
      <span class="sr-only">Ecoquimia</span>
    </a>

    <nav class="nav-desktop ml-auto hidden items-center gap-4 lg:gap-5 xl:gap-6 md:flex" aria-label="Principal">
      {links.map((link) => (
        <a
          href={link.href}
          class={`nav-link px-1 ${isActive(link.href) ? "is-active" : ""}`}
          aria-current={isActive(link.href) ? "page" : undefined}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="ml-auto hidden items-center gap-3 md:flex">
      <a href="/cotizacion" class="btn btn-accent px-5" aria-label="Cotización">
        Cotización
      </a>
    </div>

    <button
      id="navToggle"
      type="button"
      class="inline-flex min-h-11 min-w-11 shrink-0 items-center justify-center rounded-2xl border border-[color:var(--color-border-strong)] bg-white/80 text-[color:var(--color-forest)] shadow-sm md:hidden"
      aria-label="Abrir menu"
      aria-controls="mobileMenu"
      aria-expanded="false"
    >
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" aria-hidden="true">
        <path id="burgerPath" stroke-linecap="round" stroke-width="1.8" d="M4 7h16M4 12h16M4 17h16" />
      </svg>
    </button>
  </div>

  <div
    id="mobileMenu"
    class="hidden w-full max-w-full overflow-x-hidden border-t border-[color:var(--color-border)] bg-[color:var(--color-cream)] md:hidden"
    aria-hidden="true"
  >
    <nav class="nav-mobile container-max box-border w-full max-w-full py-4" aria-label="Movil">
      <ul class="flex flex-col gap-1">
        {links.map((link) => (
          <li>
            <a
              href={link.href}
              class={`flex min-h-11 items-center justify-between rounded-2xl px-4 py-3 no-underline ${isActive(link.href) ? "bg-[color:var(--color-forest)] text-white" : "text-[color:var(--color-forest)] hover:bg-white"}`}
              aria-current={isActive(link.href) ? "page" : undefined}
              data-close
            >
              <span>{link.label}</span>
              <span class="text-sm opacity-70">/</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="pb-[max(env(safe-area-inset-bottom),0.5rem)]"></div>
    </nav>
  </div>
</header>

<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const btn = document.getElementById("navToggle");
    const panel = document.getElementById("mobileMenu");
    const burgerPath = document.getElementById("burgerPath");
    if (!btn || !panel) return;

    const mqDesktop = matchMedia("(min-width: 768px)");
    const BURGER = "M4 7h16M4 12h16M4 17h16";
    const CLOSE = "M6 6l12 12M6 18L18 6";
    const header = btn.closest("header");
    const scrollRoots = [document.documentElement, document.body];
    let previousScrollLocks = null;

    // Use the rendered header height, including text zoom, for the panel's limit.
    const headerObserver = new ResizeObserver(() => {
      panel.style.setProperty("--mobile-menu-header-height", `${header.getBoundingClientRect().height}px`);
    });
    headerObserver.observe(header);

    function lockBodyScroll(lock) {
      if (mqDesktop.matches) lock = false;
      if (lock && !previousScrollLocks) {
        previousScrollLocks = scrollRoots.map((root) => root.classList.contains("overflow-hidden"));
        scrollRoots.forEach((root) => root.classList.add("overflow-hidden"));
      } else if (!lock && previousScrollLocks) {
        scrollRoots.forEach((root, index) => root.classList.toggle("overflow-hidden", previousScrollLocks[index]));
        previousScrollLocks = null;
      }
    }

    function setOpen(open) {
      open = open && !mqDesktop.matches;
      const focusWasInPanel = panel.contains(document.activeElement);
      btn.setAttribute("aria-expanded", String(open));
      btn.setAttribute("aria-label", open ? "Cerrar menu" : "Abrir menu");
      panel.classList.toggle("hidden", !open);
      panel.setAttribute("aria-hidden", String(!open));
      if (burgerPath) burgerPath.setAttribute("d", open ? CLOSE : BURGER);
      lockBodyScroll(open);
      if (open) {
        panel.querySelector("a[href]")?.focus({ preventScroll: true });
      } else if (mqDesktop.matches && (focusWasInPanel || document.activeElement === btn)) {
        header.querySelector(".nav-desktop a[aria-current='page'], .nav-desktop a")?.focus({ preventScroll: true });
      } else if (focusWasInPanel) {
        btn.focus({ preventScroll: true });
      }
    }

    btn.addEventListener("click", () => {
      const isOpen = btn.getAttribute("aria-expanded") === "true";
      setOpen(!isOpen);
    });

    panel.querySelectorAll("[data-close]").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    mqDesktop.addEventListener("change", (event) => {
      if (event.matches) setOpen(false);
    });

    document.addEventListener("keydown", (event) => {
      if (btn.getAttribute("aria-expanded") !== "true") return;
      if (event.key === "Tab") {
        const items = [btn, ...panel.querySelectorAll("a[href], button:not([disabled])")];
        const index = items.indexOf(document.activeElement);
        if (event.shiftKey && index <= 0) {
          event.preventDefault();
          items[items.length - 1].focus();
        } else if (!event.shiftKey && (index === items.length - 1 || index === -1)) {
          event.preventDefault();
          btn.focus({ preventScroll: true });
        }
      }
      if (event.key === "Escape" && btn.getAttribute("aria-expanded") === "true") {
        event.preventDefault();
        setOpen(false);
        btn.focus({ preventScroll: true });
      }
    });

    if (!mqDesktop.matches && window.location.hash === "#mobileMenu") {
      setOpen(true);
    }
  });
</script>
