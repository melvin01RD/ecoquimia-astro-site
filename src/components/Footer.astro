---
import { config } from "../config";
import { PHONE_E164, EMAIL_COMMERCIAL, BUSINESS_HOURS } from "../config/business";
import { Phone, Mail, MapPin, Clock, Instagram, Facebook } from "@lucide/astro";
const year = new Date().getFullYear();

const SOCIAL_LINKS = [
  { label: "Instagram", href: "https://www.instagram.com/fumigadora_eco_quimia/", Icon: Instagram },
  { label: "Facebook", href: "https://www.facebook.com/FumigadoraEcoQuimia", Icon: Facebook },
];
---

<footer role="contentinfo" class="mt-16 bg-zinc-950 relative isolate overflow-hidden text-white">
  <!-- Fondo/overlay (no bloquea clics) -->
  <div
    class="absolute inset-0 z-0 pointer-events-none bg-gradient-to-b from-zinc-900/10 via-zinc-900/30 to-zinc-950"
    aria-hidden="true"
  ></div>

  <!-- Contenido clickeable -->
  <div class="container-max relative z-10 py-12 grid gap-10 sm:grid-cols-2 lg:grid-cols-3 pointer-events-auto">
    <!-- Marca -->
    <div class="text-center sm:text-left">
      <a href="/" class="flex items-center justify-center sm:justify-start gap-2 text-lg font-bold no-underline" aria-label="Ir al inicio">
        <span>Ecoquimia</span>
      </a>
      <p class="mt-3 text-base tracking-wide text-white/85">
        Control integral de plagas para hogares y empresas. Santo Domingo, RD.
      </p>

      <!-- Redes sociales -->
      <div class="mt-5 flex items-center justify-center sm:justify-start gap-3">
        {SOCIAL_LINKS.map(({ label, href, Icon }) => (
          <a
            href={href}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={label}
            class="inline-flex h-11 w-11 items-center justify-center rounded-full bg-white/10 text-white hover:bg-white/20 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500"
          >
            <Icon class="w-5 h-5" aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>

    <!-- Contacto -->
    <div class="text-center sm:text-left">
      <h4 class="font-semibold mb-3">Contacto</h4>
      <address class="not-italic">
        <ul class="space-y-2 text-base tracking-wide">
          <li class="flex items-center justify-center sm:justify-start gap-2">
            <Phone class="w-4 h-4 shrink-0 text-white/70" aria-hidden="true" />
            <a
              href={`tel:${PHONE_E164}`}
              class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
            >
              {config.contact.phoneDisplay}
            </a>
          </li>
          <li class="flex items-center justify-center sm:justify-start gap-2">
            <Mail class="w-4 h-4 shrink-0 text-white/70" aria-hidden="true" />
            <a
              href={`mailto:${EMAIL_COMMERCIAL}`}
              class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded"
            >
              {EMAIL_COMMERCIAL}
            </a>
          </li>
          <li class="flex items-center justify-center sm:justify-start gap-2">
            <MapPin class="w-4 h-4 shrink-0 text-white/70" aria-hidden="true" />
            <span>{config.contact.address}</span>
          </li>
          <li class="flex items-center justify-center sm:justify-start gap-2">
            <Clock class="w-4 h-4 shrink-0 text-white/70" aria-hidden="true" />
            <span>{BUSINESS_HOURS}</span>
          </li>
        </ul>
      </address>
    </div>

    <!-- Enlaces -->
    <nav aria-label="Enlaces del sitio" class="text-center sm:text-left">
      <h4 class="font-semibold mb-3">Enlaces</h4>
      <ul class="space-y-2 text-base tracking-wide">
        <li><a href="/"                   class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded">Inicio</a></li>
        <li><a href="/nosotros"           class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded">Nosotros</a></li>
  <li><a href="/servicios"           class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded">Servicios</a></li>
        <li><a href="/cotizacion"         class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded">Cotización</a></li>
        <li><a href="/aprende-de-las-plagas" class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded">Aprende de las plagas</a></li>
        <li><a href="/contacto"           class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded">Contacto</a></li>
        <li><a href="/politicas"          class="text-white/80 hover:text-white underline-offset-4 hover:underline focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-emerald-500 rounded">Políticas</a></li>
      </ul>
    </nav>
  </div>

  <!-- Legal -->
  <div class="border-t border-white/10 relative z-10">
    <div class="container-max pt-6 pb-24 sm:pb-6 text-center text-sm text-white/70">
      © <span id="js-current-year">2026</span> Ecoquimia. Todos los derechos reservados.
    </div>
  </div>

  <script>
    (() => {
      const el = document.getElementById('js-current-year');
      if (el) el.textContent = String(new Date().getFullYear());
    })();
  </script>
</footer>