---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { services } from "../data/services";
import ServiceCard from "../components/ServiceCard.astro";
import { Shield, Clock, Award, CheckCircle2 } from "@lucide/astro";
import { config } from "../config";
import { buildWhatsAppUrl } from "../config/business";

export const prerender = true;

const whatsappUrl = buildWhatsAppUrl(config.contact.whatsappText);
---

<Base title="Ecoquimia - Control de Plagas y Fumigación en Santo Domingo" description="Empresa de fumigación en Santo Domingo y control de plagas en República Dominicana. Tratamientos certificados para hogares y negocios con garantía por escrito.">
  <Header slot="header" />

  <section class="container-max py-8 md:py-12 lg:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(340px,0.95fr)] lg:gap-12">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-white/80 px-4 py-2 text-sm font-semibold text-[color:var(--color-forest)] shadow-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-[color:var(--color-brand)]"></span>
          Control profesional de plagas
        </p>

        <h1 class="mt-5 max-w-xl text-4xl font-extrabold leading-[0.95] text-[color:var(--color-forest)] sm:text-5xl lg:text-6xl">
          Tu espacio, libre de plagas.
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-8 text-[color:var(--color-charcoal)]/82">
          Control profesional para hogares y empresas, con inspección, tratamiento y seguimiento.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary justify-center px-7 py-3 text-base shadow-lg shadow-emerald-950/10">
            Cotizar por WhatsApp
          </a>
          <a href="/servicios" class="btn btn-outline justify-center px-7 py-3 text-base">
            Conocer los servicios
          </a>
        </div>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          <li class="rounded-2xl border border-[color:var(--color-border)] bg-white/80 px-4 py-4 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-brand)]">Experiencia</p>
            <p class="mt-2 text-base font-semibold text-[color:var(--color-forest)]">+10 años de experiencia</p>
          </li>
          <li class="rounded-2xl border border-[color:var(--color-border)] bg-white/80 px-4 py-4 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-brand)]">Respaldo</p>
            <p class="mt-2 text-base font-semibold text-[color:var(--color-forest)]">Garantía por escrito</p>
          </li>
        </ul>
      </div>

      <div class="hero-media">
        <div class="mb-3 inline-flex rounded-full border border-[color:var(--color-border)] bg-white/75 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-muted)]">
          Contenedor temporal para fotografia real
        </div>
        <div class="overflow-hidden rounded-[2rem] border border-[color:var(--color-border-strong)] bg-white shadow-[0_24px_60px_rgba(23,63,53,0.12)]">
          <img
            src="/hero-tecnico-placeholder.svg"
            width="720"
            height="900"
            alt="Espacio reservado para una fotografía real de un técnico de Ecoquimia realizando una inspección de control de plagas"
            class="h-full w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <p class="mt-3 max-w-md text-sm leading-6 text-[color:var(--color-muted)]">
          Placeholder neutro mientras se aprueba una fotografía real del técnico de Ecoquimia trabajando en sitio.
        </p>
      </div>
    </div>
  </section>

  <!-- SECCION DE CONFIANZA -->
  <section class="container-max pb-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-emerald-100 p-2 shrink-0">
          <Shield class="w-5 h-5 text-emerald-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">Productos certificados</p>
          <p class="text-sm text-zinc-600">EPA y salud pública</p>
        </div>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-blue-100 p-2 shrink-0">
          <Clock class="w-5 h-5 text-blue-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">Respuesta rápida</p>
          <p class="text-sm text-zinc-600">En menos de 24 horas</p>
        </div>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-amber-100 p-2 shrink-0">
          <Award class="w-5 h-5 text-amber-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">+10 años de experiencia</p>
          <p class="text-sm text-zinc-600">Personal capacitado</p>
        </div>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-purple-100 p-2 shrink-0">
          <CheckCircle2 class="w-5 h-5 text-purple-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">Garantía por escrito</p>
          <p class="text-sm text-zinc-600">En todos los servicios</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="container-max py-16" aria-labelledby="srv-title">
    <div class="text-center">
      <h2 id="srv-title" class="text-2xl md:text-3xl font-bold text-zinc-900">Nuestros servicios</h2>
      <div class="mx-auto mt-3 h-1.5 w-20 rounded-full bg-brand"></div>
      <p class="mt-3 text-zinc-600">Planes residenciales y comerciales con certificación.</p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => <ServiceCard service={s} />)}
    </div>

    <!-- CTA despues de servicios -->
    <div class="mt-10 flex flex-wrap gap-3 justify-center">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Cotizar por WhatsApp</a>
      <a href="/cotizacion" class="btn btn-outline">Solicitar cotización</a>
    </div>
  </section>

  <!-- APRENDE DE LAS PLAGAS -->
  <section class="container-max pb-16">
    <div class="rounded-3xl border border-black/5 bg-gradient-to-br from-emerald-50 to-white p-6 md:p-8">
      <h3 class="text-xl md:text-2xl font-semibold text-zinc-900">Aprende de las plagas</h3>
      <p class="mt-2 text-zinc-700">Consejos prácticos y guías rápidas para tu hogar o negocio.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/aprende-de-las-plagas" class="btn btn-primary" data-astro-prefetch>Guias y consejos</a>
        <a href="/contacto" class="btn btn-outline" data-astro-prefetch>Contacto</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
