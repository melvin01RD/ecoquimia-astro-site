---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import ServiceIcon from "../components/ServiceIcon.astro";
import { services, homepageFeaturedServices, homepageCompactServices } from "../data/services";
import { sectors, attendedSpaces } from "../data/categories";
import { config } from "../config";
import { buildWhatsAppUrl } from "../config/business";

export const prerender = true;

const whatsappUrl = buildWhatsAppUrl(config.contact.whatsappText);
const serviceBySlug = new Map(services.map((service) => [service.slug, service]));
type FeaturedHomepageService = (typeof homepageFeaturedServices)[number] & {
  service: (typeof services)[number];
};
const featuredServices = homepageFeaturedServices
  .map((item) => {
    const service = item.relatedSlug ? serviceBySlug.get(item.relatedSlug) : undefined;
    return service ? { ...item, service } : null;
  })
  .filter((item): item is FeaturedHomepageService => item !== null);
const compactServices = homepageCompactServices;
const workSteps = [
  "Inspeccionamos el área.",
  "Recomendamos el tratamiento.",
  "Ejecutamos y damos seguimiento.",
];
---

<Base title="Ecoquimia - Control de Plagas y Fumigación en Santo Domingo" description="Empresa de fumigación en Santo Domingo y control de plagas en República Dominicana. Tratamientos certificados para hogares y negocios con garantía por escrito.">
  <Header slot="header" />

  <section class="container-max py-8 md:py-12 lg:py-16">
    <div class="grid items-center gap-8 lg:grid-cols-[minmax(0,1.05fr)_minmax(340px,0.95fr)] lg:gap-12">
      <div class="max-w-2xl">
        <p class="inline-flex items-center gap-2 rounded-full border border-[color:var(--color-border)] bg-white/80 px-4 py-2 text-sm font-semibold text-[color:var(--color-forest)] shadow-sm">
          <span class="h-2.5 w-2.5 rounded-full bg-[color:var(--color-brand)]"></span>
          Control profesional de plagas
        </p>

        <h1 class="mt-5 max-w-xl text-4xl font-extrabold leading-[0.95] text-[color:var(--color-forest)] sm:text-5xl lg:text-6xl">
          Tu espacio, libre de plagas.
        </h1>

        <p class="mt-5 max-w-xl text-lg leading-8 text-[color:var(--color-charcoal)]/82">
          Control profesional para hogares y empresas, con inspección, tratamiento y seguimiento.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary justify-center px-7 py-3 text-base shadow-lg shadow-emerald-950/10">
            Cotizar por WhatsApp
          </a>
          <a href="/servicios" class="btn btn-outline justify-center px-7 py-3 text-base">
            Conocer los servicios
          </a>
        </div>

        <ul class="mt-8 grid gap-3 sm:grid-cols-2">
          <li class="rounded-2xl border border-[color:var(--color-border)] bg-white/80 px-4 py-4 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-brand)]">Experiencia</p>
            <p class="mt-2 text-base font-semibold text-[color:var(--color-forest)]">+10 años de experiencia</p>
          </li>
          <li class="rounded-2xl border border-[color:var(--color-border)] bg-white/80 px-4 py-4 shadow-sm">
            <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-brand)]">Respaldo</p>
            <p class="mt-2 text-base font-semibold text-[color:var(--color-forest)]">Garantía por escrito</p>
          </li>
        </ul>
      </div>

      <div class="hero-media">
        <div class="mb-3 inline-flex rounded-full border border-[color:var(--color-border)] bg-white/75 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-muted)]">
          Contenedor temporal para fotografia real
        </div>
        <div class="overflow-hidden rounded-[2rem] border border-[color:var(--color-border-strong)] bg-white shadow-[0_24px_60px_rgba(23,63,53,0.12)]">
          <img
            src="/hero-tecnico-placeholder.svg"
            width="720"
            height="900"
            alt="Espacio reservado para una fotografía real de un técnico de Ecoquimia realizando una inspección de control de plagas"
            class="h-full w-full object-cover"
            loading="eager"
            decoding="async"
            fetchpriority="high"
          />
        </div>
        <p class="mt-3 max-w-md text-sm leading-6 text-[color:var(--color-muted)]">
          Placeholder neutro mientras se aprueba una fotografía real del técnico de Ecoquimia trabajando en sitio.
        </p>
      </div>
    </div>
  </section>

  <section class="container-max pb-10">
    <div class="grid gap-6 rounded-[2rem] border border-[color:var(--color-border)] bg-white/70 p-6 shadow-sm lg:grid-cols-[minmax(0,1.15fr)_minmax(280px,0.85fr)] lg:items-end">
      <div class="max-w-2xl">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Atención residencial y comercial</p>
        <h2 class="mt-3 text-2xl font-bold text-[color:var(--color-forest)] md:text-3xl">
          Protección profesional para hogares, negocios e instalaciones.
        </h2>
        <p class="mt-3 text-base leading-7 text-[color:var(--color-charcoal)]/80">
          Encuentra soluciones de control de plagas y conoce los espacios donde Ecoquimia brinda atención para diferentes necesidades.
        </p>
      </div>

      <div class="grid gap-3 sm:grid-cols-3 lg:grid-cols-1">
        <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-cream)]/75 px-4 py-4">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-brand)]">Servicios</p>
          <p class="mt-2 text-base font-semibold text-[color:var(--color-forest)]">Tratamientos y soluciones</p>
        </div>
        <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-cream)]/75 px-4 py-4">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-brand)]">Sectores</p>
          <p class="mt-2 text-base font-semibold text-[color:var(--color-forest)]">Tipos de operación atendidos</p>
        </div>
        <div class="rounded-2xl border border-[color:var(--color-border)] bg-[color:var(--color-cream)]/75 px-4 py-4">
          <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[color:var(--color-brand)]">Espacios</p>
          <p class="mt-2 text-base font-semibold text-[color:var(--color-forest)]">Zonas físicas atendidas</p>
        </div>
      </div>
    </div>
  </section>

  <section class="container-max py-16" aria-labelledby="srv-title">
    <div class="grid gap-10 lg:grid-cols-[minmax(0,1.15fr)_minmax(300px,0.85fr)]">
      <div>
        <div class="max-w-2xl">
          <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Servicios de control de plagas</p>
          <h2 id="srv-title" class="mt-3 text-2xl font-bold text-[color:var(--color-forest)] md:text-3xl">
            Soluciones para proteger cada espacio
          </h2>
          <p class="mt-3 text-base leading-7 text-[color:var(--color-charcoal)]/80">
            Tratamientos profesionales para prevenir y controlar plagas en hogares, negocios e instalaciones.
          </p>
        </div>

        <div class="mt-10 grid gap-6 xl:grid-cols-3">
          {featuredServices.map(({ service, ...item }) => (
            <article class="overflow-hidden rounded-[1.75rem] border border-[color:var(--color-border)] bg-white shadow-[0_18px_40px_rgba(23,63,53,0.08)]">
              {service.imgSrc && (
                <Image
                  src={service.imgSrc}
                  alt={service.imgAlt ?? service.title}
                  width={640}
                  height={420}
                  loading="lazy"
                  class="h-52 w-full object-cover"
                />
              )}
              <div class="p-6">
                <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">
                  {item.featuredLabel}
                </p>
                <h3 class="mt-3 text-xl font-bold text-[color:var(--color-forest)]">{service.title}</h3>
                <p class="mt-3 text-sm leading-6 text-[color:var(--color-charcoal)]/78">{item.description ?? service.description}</p>
                <ul class="mt-4 space-y-2 text-sm text-[color:var(--color-charcoal)]/82">
                  {service.bullets.slice(0, 3).map((bullet: string) => (
                    <li class="flex gap-2">
                      <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-[color:var(--color-brand)]"></span>
                      <span>{bullet}</span>
                    </li>
                  ))}
                </ul>
                <div class="mt-6 flex flex-wrap gap-3">
                  <a href={item.href} class="btn btn-primary px-5 py-2.5 text-sm">
                    Solicitar este servicio
                  </a>
                  <a href="/servicios" class="btn btn-outline px-5 py-2.5 text-sm">
                    Ver todos
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>

      <aside class="surface rounded-[1.75rem] p-6" aria-labelledby="compact-services-title">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Más soluciones</p>
        <h3 id="compact-services-title" class="mt-3 text-xl font-bold text-[color:var(--color-forest)]">
          También ofrecemos otras soluciones adaptadas a las necesidades de cada espacio.
        </h3>
        <div class="mt-6 space-y-4">
          {compactServices.map((item) => (
            <article class="rounded-2xl border border-[color:var(--color-border)] bg-white/80 p-4">
              <div class="flex items-start gap-3">
                <div class="grid h-11 w-11 shrink-0 place-items-center rounded-2xl bg-[color:var(--color-cream)] text-[color:var(--color-brand)]">
                  {item.relatedSlug ? (
                    <ServiceIcon slug={item.relatedSlug} class="h-5 w-5" />
                  ) : (
                    <span class="text-sm font-bold">{item.title.slice(0, 1)}</span>
                  )}
                </div>
                <div class="min-w-0">
                  <h4 class="text-base font-semibold text-[color:var(--color-forest)]">{item.title}</h4>
                  <p class="mt-1 text-sm leading-6 text-[color:var(--color-charcoal)]/76">{item.description}</p>
                  <a href={item.href} class="mt-3 inline-flex text-sm font-semibold text-[color:var(--color-brand)] no-underline hover:text-[color:var(--color-brand-strong)]">
                    {item.href === "/servicios" ? "Conocer más" : "Solicitar cotización"}
                  </a>
                </div>
              </div>
            </article>
          ))}
        </div>
      </aside>
    </div>

    <div class="mt-10 flex flex-wrap justify-center gap-3">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Cotizar por WhatsApp</a>
      <a href="/cotizacion" class="btn btn-outline">Solicitar cotización</a>
    </div>
  </section>

  <section class="container-max py-4" aria-labelledby="process-title">
    <div class="rounded-[1.75rem] border border-[color:var(--color-border)] bg-[color:var(--color-cream)]/70 p-6 md:p-8">
      <div class="mx-auto max-w-3xl text-center">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Cómo trabajamos</p>
        <h2 id="process-title" class="mt-3 text-2xl font-bold text-[color:var(--color-forest)] md:text-3xl">
          Un proceso claro y profesional
        </h2>
        <p class="mt-3 text-base leading-7 text-[color:var(--color-charcoal)]/80">
          Evaluamos cada situación para recomendar el tratamiento adecuado y brindar seguimiento durante el proceso.
        </p>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-3">
        {workSteps.map((step, index) => (
          <article class="rounded-2xl border border-[color:var(--color-border)] bg-white/80 p-5 text-center">
            <p class="text-xs font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Paso {index + 1}</p>
            <p class="mt-3 text-lg font-semibold text-[color:var(--color-forest)]">{step}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="container-max py-16" aria-labelledby="coverage-title">
    <div class="grid gap-8 rounded-[1.75rem] border border-[color:var(--color-border)] bg-white/75 p-6 md:p-8 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Atención residencial y comercial</p>
        <h2 id="coverage-title" class="mt-3 text-2xl font-bold text-[color:var(--color-forest)] md:text-3xl">
          Espacios y sectores atendidos
        </h2>
        <p class="mt-3 text-base leading-7 text-[color:var(--color-charcoal)]/80">
          Brindamos soluciones de control de plagas adaptadas a diferentes tipos de espacios e instalaciones.
        </p>
        <div class="mt-6 flex flex-wrap gap-3">
          {sectors.map((sector) => (
            <span class="rounded-full border border-[color:var(--color-border)] bg-[color:var(--color-cream)]/75 px-4 py-2 text-sm font-semibold text-[color:var(--color-forest)]">
              {sector.label}
            </span>
          ))}
        </div>
      </div>

      <div class="rounded-[1.5rem] border border-[color:var(--color-border)] bg-[color:var(--color-cream)]/55 p-5">
        <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[color:var(--color-brand)]">Espacios atendidos</p>
        <p class="mt-3 text-base leading-7 text-[color:var(--color-charcoal)]/80">
          Atención para distintas áreas y zonas de uso residencial, comercial e institucional.
        </p>
        <ul class="mt-5 space-y-3">
          {attendedSpaces.map((space) => (
            <li class="flex items-start gap-3 rounded-2xl border border-[color:var(--color-border)] bg-white/80 px-4 py-3">
              <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[color:var(--color-brand)]"></span>
              <span class="text-sm font-semibold text-[color:var(--color-forest)]">{space.label}</span>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <section class="container-max pb-16">
    <div class="rounded-3xl border border-black/5 bg-gradient-to-br from-emerald-50 to-white p-6 md:p-8">
      <h3 class="text-xl font-semibold text-zinc-900 md:text-2xl">Aprende de las plagas</h3>
      <p class="mt-2 text-zinc-700">Consejos prácticos y guías rápidas para tu hogar o negocio.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/aprende-de-las-plagas" class="btn btn-primary" data-astro-prefetch>Guias y consejos</a>
        <a href="/contacto" class="btn btn-outline" data-astro-prefetch>Contacto</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>
