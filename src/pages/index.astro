---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { services } from "../data/services";
import ServiceCard from "../components/ServiceCard.astro";
import { Shield, Clock, Award, CheckCircle2 } from "@lucide/astro";
import { config } from "../config";
import { buildWhatsAppUrl } from "../config/business";

export const prerender = true;

const whatsappUrl = buildWhatsAppUrl(config.contact.whatsappText);
---

<Base title="Ecoquimia - Control de Plagas y Fumigación en Santo Domingo" description="Empresa de fumigación en Santo Domingo y control de plagas en República Dominicana. Tratamientos certificados para hogares y negocios con garantía por escrito.">
  <Header slot="header" />

  <!-- HERO: copy remains HTML; the image contains no branding. -->
  <section class="hero-banner eco-hero" aria-labelledby="hero-title">
    <div class="hero-media">
      <img
        src="/logo/hero-mosquito-ecoquimia.webp"
        alt="Control de plagas profesional - Ecoquimia"
        loading="eager"
        decoding="async"
        fetchpriority="high"
        width="1746"
        height="982"
      />
    </div>
    <div class="hero-copy">
      <div class="bg-emerald-900 text-emerald-50 text-sm rounded px-3 py-2 mb-4">
          <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 inline-block align-middle mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg>
          <span>Respuesta en menos de 24 horas · Garantía por escrito</span>
      </div>
        <h1 id="hero-title" class="text-2xl sm:text-4xl md:text-5xl font-extrabold text-white leading-tight max-w-2xl">
          Control profesional de plagas en Santo Domingo
        </h1>
        <p class="mt-3 max-w-xl text-base md:text-lg text-white/90">
          Soluciones efectivas, seguras y certificadas para hogares y negocios en toda la República Dominicana.
        </p>
        <div class="hero-actions mt-6 flex flex-wrap gap-3">
          <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary text-base px-7 py-3 shadow-lg">Cotizar por WhatsApp</a>
          <a href="/cotizacion" class="btn btn-outline text-base px-7 py-3 bg-white/90">Solicitar cotización</a>
        </div>
    </div>
  </section>

  <!-- SECCION DE CONFIANZA -->
  <section class="container-max pb-10">
    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-emerald-100 p-2 shrink-0">
          <Shield class="w-5 h-5 text-emerald-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">Productos certificados</p>
          <p class="text-sm text-zinc-600">EPA y salud pública</p>
        </div>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-blue-100 p-2 shrink-0">
          <Clock class="w-5 h-5 text-blue-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">Respuesta rápida</p>
          <p class="text-sm text-zinc-600">En menos de 24 horas</p>
        </div>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-amber-100 p-2 shrink-0">
          <Award class="w-5 h-5 text-amber-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">+10 años de experiencia</p>
          <p class="text-sm text-zinc-600">Personal capacitado</p>
        </div>
      </div>

      <div class="rounded-xl border border-zinc-200 bg-white p-4 flex items-center gap-3 transition hover:shadow-md">
        <div class="rounded-full bg-purple-100 p-2 shrink-0">
          <CheckCircle2 class="w-5 h-5 text-purple-600" />
        </div>
        <div>
          <p class="font-semibold text-zinc-900">Garantía por escrito</p>
          <p class="text-sm text-zinc-600">En todos los servicios</p>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICIOS -->
  <section class="container-max py-16" aria-labelledby="srv-title">
    <div class="text-center">
      <h2 id="srv-title" class="text-2xl md:text-3xl font-bold text-zinc-900">Nuestros servicios</h2>
      <div class="mx-auto mt-3 h-1.5 w-20 rounded-full bg-brand"></div>
      <p class="mt-3 text-zinc-600">Planes residenciales y comerciales con certificación.</p>
    </div>

    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {services.map((s) => <ServiceCard service={s} />)}
    </div>

    <!-- CTA despues de servicios -->
    <div class="mt-10 flex flex-wrap gap-3 justify-center">
      <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary">Cotizar por WhatsApp</a>
      <a href="/cotizacion" class="btn btn-outline">Solicitar cotización</a>
    </div>
  </section>

  <!-- APRENDE DE LAS PLAGAS -->
  <section class="container-max pb-16">
    <div class="rounded-3xl border border-black/5 bg-gradient-to-br from-emerald-50 to-white p-6 md:p-8">
      <h3 class="text-xl md:text-2xl font-semibold text-zinc-900">Aprende de las plagas</h3>
      <p class="mt-2 text-zinc-700">Consejos prácticos y guías rápidas para tu hogar o negocio.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href="/aprende-de-las-plagas" class="btn btn-primary" data-astro-prefetch>Guias y consejos</a>
        <a href="/contacto" class="btn btn-outline" data-astro-prefetch>Contacto</a>
      </div>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  .eco-hero {
    display: grid;
    background: #132b20;
    margin-bottom: 2rem;
  }

  .hero-media {
    position: relative;
    min-width: 0;
    aspect-ratio: 1746 / 982;
  }

  .hero-media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 65% center;
  }

  .hero-media::after {
    content: "";
    position: absolute;
    inset: 0;
    pointer-events: none;
    background: linear-gradient(to top, #132b20, transparent 25%);
  }

  .hero-copy {
    position: relative;
    min-width: 0;
    padding: clamp(1.5rem, 4vw, 3rem) clamp(1rem, 3vw, 2rem);
    overflow-wrap: anywhere;
  }

  .hero-copy h1 {
    font-size: clamp(1.5rem, 4vw, 3rem);
  }

  .hero-actions .btn {
    max-width: 100%;
    flex: 1 1 14rem;
  }

  .hero-copy .btn {
    white-space: normal;
    text-align: center;
  }

  @media (min-width: 768px) {
    .hero-media { aspect-ratio: 2 / 1; }
    .hero-media img { object-position: center 45%; }
    .hero-actions .btn { flex: 0 1 auto; }
  }

  @media (min-width: 1024px) {
    .eco-hero {
      grid-template-columns: minmax(0, 42%) minmax(0, 58%);
      align-items: center;
      min-height: clamp(30rem, 42vw, 38rem);
    }

    .hero-media {
      grid-column: 2;
      grid-row: 1;
      aspect-ratio: 1746 / 982;
    }

    .hero-media img { object-position: right center; }

    .hero-media::after {
      background: linear-gradient(to right, #132b20, transparent 18%);
    }

    .hero-copy {
      grid-column: 1;
      grid-row: 1;
      padding: 3rem 1.5rem 3rem max(1rem, calc((100vw - 1152px) / 2 + 1rem));
    }
  }
</style>
